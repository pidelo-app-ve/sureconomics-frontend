{
    "name": "sureconomics-frontend",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "overrides": {
        "prosemirror-view": "^1.42.8"
    },
    "scripts": {
        "dev": "vite",
        "start": "vite",
        "build": "vite build && node scripts/shell-como-app.mjs",
        "lint": "eslint -c eslint.cjs . --ext js,jsx --report-unused-disable-directives --max-warnings 0 && node scripts/i18n-comprobar.mjs",
        "test": "node --import ./scripts/pruebas/cargador-jsx.mjs --test",
        "preview": "vite preview",
        "test:og": "node api/pieza.test.mjs && node api/no-encontrada.test.mjs && node api/portada.test.mjs",
        "test:rutas": "node api/rutas.test.mjs",
        "test:enlaces": "node src/lib/enlaces.test.mjs",
        "test:sitemap": "node api/sitemap.test.mjs",
        "test:i18n": "node src/i18n/motor.test.mjs",
        "test:guacamaya": "node src/juegos/guacamaya/motor.test.mjs",
        "test:clave": "node src/juegos/clave/motor.test.mjs",
        "test:recorrido": "node src/lib/recorridoVista.test.mjs && node src/lib/todasLasGuias.test.mjs",
        "test:relojes": "node src/lib/relojes.test.mjs",
        "test:ultimahora": "node src/features/titulares/utils.test.mjs",
        "test:titulares-panel": "node src/features/titulares/admin/utils.test.mjs",
        "test:publicidad": "node src/features/publicidad/utils.test.mjs && node src/features/publicidad/admin/utils.test.mjs",
        "test:aligerar": "node --import ./scripts/pruebas/cargador-jsx.mjs --test src/components/admin/aligerarImagen.test.mjs src/components/admin/editorDePieza/subirFotoDePieza.test.mjs",
        "test:youtube": "node src/lib/youtube.test.mjs",
        "test:avisos": "node src/lib/avisos.test.mjs",
        "test:llegada": "node src/features/analitica/utils.test.mjs",
        "test:audiencia": "node src/features/analitica/admin/utils.test.mjs",
        "test:lotes": "node src/lib/lotesDeEnvio.test.mjs && node src/features/publicidad/envioDeVistos.test.mjs",
        "i18n": "node scripts/i18n-comprobar.mjs",
        "traer-analista": "node scripts/traer-el-analista.mjs"
    },
    "dependencies": {
        "@tiptap/extension-link": "^3.32.2",
        "@tiptap/extension-placeholder": "^3.32.2",
        "@tiptap/pm": "^3.32.2",
        "@tiptap/react": "^3.32.2",
        "@tiptap/starter-kit": "^3.32.2",
        "prop-types": "^15.8.1",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-router-dom": "^6.30.6"
    },
    "devDependencies": {
        "@happy-dom/global-registrator": "21.0.4",
        "@testing-library/dom": "10.4.2",
        "@testing-library/react": "16.3.3",
        "@types/react": "^18.2.18",
        "@types/react-dom": "^18.2.7",
        "@vitejs/plugin-react": "^4.0.4",
        "eslint": "^8.46.0",
        "eslint-plugin-react": "^7.33.1",
        "eslint-plugin-react-hooks": "^4.6.2",
        "eslint-plugin-react-refresh": "^0.4.3",
        "espree": "^9.6.1",
        "happy-dom": "21.0.4",
        "vite": "^4.4.8"
    },
    "engines": {
        "node": ">=20.0.0"
    }
}
