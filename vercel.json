{
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "redirects": [
        {
            "source": "/articulo/:slug",
            "destination": "/articulos/:slug",
            "permanent": true
        },
        {
            "source": "/categoria/:slug",
            "destination": "/explorar",
            "permanent": true
        }
    ],
    "rewrites": [
        {
            "source": "/media/:ruta*",
            "destination": "https://sureconomics-backend.onrender.com/media/:ruta*"
        },
        {
            "source": "/:seccion(noticias|articulos|editorial|entrevistas|informes)/:slug",
            "has": [
                {
                    "type": "query",
                    "key": "_s"
                }
            ],
            "destination": "/index.html"
        },
        {
            "source": "/:seccion(noticias|articulos|editorial|entrevistas|informes)/:slug",
            "destination": "/api/pieza?seccion=:seccion&slug=:slug"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "Content-Security-Policy-Report-Only",
                    "value": "default-src 'self'; script-src 'self' https://s3.tradingview.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: blob: https://res.cloudinary.com https://*.cloudflarestream.com https://videodelivery.net https://s3.tradingview.com https://*.tradingview.com; connect-src 'self' https://sureconomics-backend.onrender.com https://upload.cloudflarestream.com https://*.tradingview.com https://*.tradingview-widget.com; frame-src 'self' https://*.tradingview-widget.com https://*.tradingview.com https://*.cloudflarestream.com https://iframe.videodelivery.net https://www.youtube.com https://www.youtube-nocookie.com https://player.vimeo.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
                },
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                },
                {
                    "key": "Permissions-Policy",
                    "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
                },
                {
                    "key": "Strict-Transport-Security",
                    "value": "max-age=31536000"
                }
            ]
        }
    ]
}
