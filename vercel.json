{
    "builds": [{
        "src": "package.json",
        "use": "@vercel/static-build"
    }],
    "redirects": [
        {
            "source": "/articulo/:slug",
            "destination": "/articulos/:slug",
            "permanent": true
        },
        {
            "source": "/categoria/:slug",
            "destination": "/explorar",
            "permanent": true
        }
    ],
    "rewrites": [{
        "source": "/(.*)",
        "destination": "/index.html"
    }]
}
