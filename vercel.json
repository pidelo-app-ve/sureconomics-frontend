{
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "redirects": [
        {
            "source": "/articulo/:slug",
            "destination": "/articulos/:slug",
            "permanent": true
        },
        {
            "source": "/categoria/:slug",
            "destination": "/explorar",
            "permanent": true
        }
    ],
    "rewrites": [
        {
            "source": "/media/:ruta*",
            "destination": "https://sureconomics-backend.onrender.com/media/:ruta*"
        },
        {
            "source": "/datos/:ruta(posts|formats|topics|places|cinta|monedas|headlines|canal|social|equipo)",
            "destination": "https://sureconomics-backend.onrender.com/:ruta"
        },
        {
            "source": "/datos/posts/:slug",
            "destination": "https://sureconomics-backend.onrender.com/posts/:slug"
        },
        {
            "source": "/datos/monedas/:codigo/historia",
            "destination": "https://sureconomics-backend.onrender.com/monedas/:codigo/historia"
        },
        {
            "source": "/datos/lvbp/:que",
            "destination": "https://sureconomics-backend.onrender.com/lvbp/:que"
        },
        {
            "source": "/datos/analitica/mas-leidas",
            "destination": "https://sureconomics-backend.onrender.com/analitica/mas-leidas"
        },
        {
            "source": "/datos/resumen/:fecha(ultimo|\\d{4}-\\d{2}-\\d{2})",
            "destination": "https://sureconomics-backend.onrender.com/resumen/:fecha"
        },
        {
            "source": "/datos/resumen/:fecha(\\d{4}-\\d{2}-\\d{2})/:edicion",
            "destination": "https://sureconomics-backend.onrender.com/resumen/:fecha/:edicion"
        },
        {
            "source": "/datos/juegos/clave/:que",
            "destination": "https://sureconomics-backend.onrender.com/juegos/clave/:que"
        },
        {
            "source": "/datos/equipo/fotos",
            "destination": "https://sureconomics-backend.onrender.com/equipo/fotos"
        },
        {
            "source": "/datos/admin/diagnostico/cliente",
            "destination": "https://sureconomics-backend.onrender.com/admin/diagnostico/cliente"
        },
        {
            "source": "/en/:seccion(noticias|articulos|editorial|entrevistas|informes|podcast)/:slug",
            "has": [
                {
                    "type": "query",
                    "key": "_s"
                }
            ],
            "destination": "/index.html"
        },
        {
            "source": "/en/:seccion(noticias|articulos|editorial|entrevistas|informes|podcast)/:slug",
            "destination": "/api/pieza?seccion=:seccion&slug=:slug&lang=en"
        },
        {
            "source": "/:seccion(noticias|articulos|editorial|entrevistas|informes|podcast)/:slug",
            "has": [
                {
                    "type": "query",
                    "key": "_s"
                }
            ],
            "destination": "/index.html"
        },
        {
            "source": "/:seccion(noticias|articulos|editorial|entrevistas|informes|podcast)/:slug",
            "destination": "/api/pieza?seccion=:seccion&slug=:slug"
        },
        {
            "source": "/entorno",
            "has": [
                {
                    "type": "query",
                    "key": "_s"
                }
            ],
            "destination": "/index.html"
        },
        {
            "source": "/entorno",
            "destination": "/api/pieza?seccion=entorno"
        },
        {
            "source": "/resumen/:fecha/:edicion",
            "has": [
                {
                    "type": "query",
                    "key": "_s"
                }
            ],
            "destination": "/index.html"
        },
        {
            "source": "/resumen/:fecha/:edicion",
            "destination": "/api/pieza?seccion=resumen&fecha=:fecha&edicion=:edicion"
        },
        {
            "source": "/sitemap.xml",
            "destination": "/api/sitemap"
        },
        {
            "source": "/sitemap-noticias.xml",
            "destination": "/api/sitemap?tipo=noticias"
        },
        {
            "source": "/((?!assets/)(?!.*\\.[A-Za-z0-9]{1,8}$).*)",
            "destination": "/index.html"
        }
    ],
    "headers": [
        {
            "source": "/fuentes/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/assets/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/brand/v2/(.*\\.[A-Za-z0-9]{1,8})",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/brand/((?!v2/).*\\.[A-Za-z0-9]{1,8})",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=86400, stale-while-revalidate=604800"
                }
            ]
        },
        {
            "source": "/lvbp/(.*\\.[A-Za-z0-9]{1,8})",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=86400, stale-while-revalidate=604800"
                }
            ]
        },
        {
            "source": "/media/:ruta*",
            "headers": [
                {
                    "key": "x-vercel-enable-rewrite-caching",
                    "value": "1"
                }
            ]
        },
        {
            "source": "/datos/:ruta*",
            "headers": [
                {
                    "key": "x-vercel-enable-rewrite-caching",
                    "value": "1"
                }
            ]
        },
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "Content-Security-Policy",
                    "value": "default-src 'self'; script-src 'self' https://s3.tradingview.com https://challenges.cloudflare.com https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; img-src 'self' data: blob: https:; font-src 'self' data:; media-src 'self' blob: https:; connect-src 'self' https://sureconomics-backend.onrender.com https://upload.cloudflarestream.com https://accounts.google.com/gsi/ https://*.tradingview.com https://*.tradingview-widget.com; frame-src https://challenges.cloudflare.com https://accounts.google.com/gsi/ https://*.tradingview.com https://*.tradingview-widget.com https://cloudflarestream.com https://*.cloudflarestream.com https://videodelivery.net https://*.videodelivery.net https://www.youtube-nocookie.com https://player.vimeo.com https://www.tiktok.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests; report-uri https://sureconomics-backend.onrender.com/csp-report"
                },
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                },
                {
                    "key": "Permissions-Policy",
                    "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
                },
                {
                    "key": "Strict-Transport-Security",
                    "value": "max-age=31536000"
                }
            ]
        }
    ]
}
