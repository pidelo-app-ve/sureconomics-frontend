{
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "redirects": [
        {
            "source": "/articulo/:slug",
            "destination": "/articulos/:slug",
            "permanent": true
        },
        {
            "source": "/categoria/:slug",
            "destination": "/explorar",
            "permanent": true
        }
    ],
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}
