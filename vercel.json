{
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "redirects": [
        {
            "source": "/articulo/:slug",
            "destination": "/articulos/:slug",
            "permanent": true
        },
        {
            "source": "/categoria/:slug",
            "destination": "/explorar",
            "permanent": true
        }
    ],
    "rewrites": [
        {
            "source": "/media/:ruta*",
            "destination": "https://sureconomics-backend.onrender.com/media/:ruta*"
        },
        {
            "source": "/en/:seccion(noticias|articulos|editorial|entrevistas|informes|podcast)/:slug",
            "has": [
                {
                    "type": "query",
                    "key": "_s"
                }
            ],
            "destination": "/index.html"
        },
        {
            "source": "/en/:seccion(noticias|articulos|editorial|entrevistas|informes|podcast)/:slug",
            "destination": "/api/pieza?seccion=:seccion&slug=:slug&lang=en"
        },
        {
            "source": "/:seccion(noticias|articulos|editorial|entrevistas|informes|podcast)/:slug",
            "has": [
                {
                    "type": "query",
                    "key": "_s"
                }
            ],
            "destination": "/index.html"
        },
        {
            "source": "/:seccion(noticias|articulos|editorial|entrevistas|informes|podcast)/:slug",
            "destination": "/api/pieza?seccion=:seccion&slug=:slug"
        },
        {
            "source": "/entorno",
            "has": [
                {
                    "type": "query",
                    "key": "_s"
                }
            ],
            "destination": "/index.html"
        },
        {
            "source": "/entorno",
            "destination": "/api/pieza?seccion=entorno"
        },
        {
            "source": "/sitemap.xml",
            "destination": "/api/sitemap"
        },
        {
            "source": "/sitemap-noticias.xml",
            "destination": "/api/sitemap?tipo=noticias"
        },
        {
            "source": "/((?!assets/).*)",
            "destination": "/index.html"
        }
    ],
    "headers": [
        {
            "source": "/fuentes/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/assets/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/media/:ruta*",
            "headers": [
                {
                    "key": "x-vercel-enable-rewrite-caching",
                    "value": "1"
                }
            ]
        },
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "Content-Security-Policy",
                    "value": "default-src 'self'; script-src 'self' https://s3.tradingview.com https://challenges.cloudflare.com https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; img-src 'self' data: blob: https:; font-src 'self' data:; media-src 'self' blob: https:; connect-src 'self' https://sureconomics-backend.onrender.com https://upload.cloudflarestream.com https://accounts.google.com/gsi/ https://*.tradingview.com https://*.tradingview-widget.com; frame-src https://challenges.cloudflare.com https://accounts.google.com/gsi/ https://*.tradingview.com https://*.tradingview-widget.com https://cloudflarestream.com https://*.cloudflarestream.com https://videodelivery.net https://*.videodelivery.net https://www.youtube-nocookie.com https://player.vimeo.com https://www.tiktok.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests; report-uri https://sureconomics-backend.onrender.com/csp-report"
                },
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                },
                {
                    "key": "Permissions-Policy",
                    "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
                },
                {
                    "key": "Strict-Transport-Security",
                    "value": "max-age=31536000"
                }
            ]
        }
    ]
}
